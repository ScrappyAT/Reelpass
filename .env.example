
# ==============================================================================
# REELPASS CINEMA BOOKING SYSTEM — ENVIRONMENT CONFIGURATION
# Graduation Project: Matinee
#
# Copy this file to .env and configure your local environment.
# NEVER commit .env, production passwords, or real API secret keys.
# ==============================================================================

# --- API Server ---
PORT=4000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=*

# --- PostgreSQL (Local Docker Development) ---
# These are development-only credentials.
# When DATABASE_URL is configured, database failures must not
# silently fall back to in-memory booking storage.
DATABASE_URL=postgresql://reelpass:reelpass@localhost:5455/reelpass
PGHOST=localhost
PGPORT=5455
PGUSER=reelpass
PGPASSWORD=reelpass
PGDATABASE=reelpass

# --- PostgreSQL Connection Pool ---
PG_POOL_MAX=100

# --- Redis (Seat Holds, Cache & Background Jobs) ---
# Local Docker Redis instance.
# Production seat holds require a working Redis connection.
REDIS_URL=redis://localhost:6385

# --- Authentication (JWT) ---
# Replace with a unique, randomly generated secret.
# Use at least 32 characters.
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d

# --- The Movie Database (TMDB) ---
# Keep TMDB credentials on the server.
# Demo movie data is available when TMDB is not configured.
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p

# --- Flutterwave Sandbox Payments ---
# Obtain test credentials from your Flutterwave dashboard.
# Never use production keys in local development.
# Payment operations must fail safely until configured.
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-your-public-key
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-your-secret-key
FLUTTERWAVE_ENCRYPTION_KEY=your-sandbox-encryption-key

# --- Mobile Client (Expo) ---
# For a physical Android phone, use your computer's LAN IP.
# Example: http://192.168.1.100:4000/api/v1
# Android emulator: http://10.0.2.2:4000/api/v1
# Local browser: http://localhost:4000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1

# --- Localization ---
# Customer-facing currency: Nigerian Naira (NGN)
# Default location: Lagos, Nigeria
# Showtime timezone: Africa/Lagos
# These settings are documented here; application defaults
# may be configured directly in the source code.
