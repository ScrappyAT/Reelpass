{
  "name": "matinee",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=@matinee/api",
    "dev:mobile": "npm run start --workspace=@matinee/mobile",
    "build:shared": "npm run build --workspace=@matinee/shared",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "eslint": "^10.12.0",
    "typescript": "^5.7.0"
  }
}
